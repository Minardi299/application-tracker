# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (target — new DB)
DATABASE_URL=postgres://user:password@localhost:5432/application_tracker

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS
FRONTEND_URL=http://localhost:49600

# --- Legacy SQL Server (source — for one-time data migration only) ---
LEGACY_DB_SERVER=localhost
LEGACY_DB_PORT=1433
LEGACY_DB_NAME=ApplicationTracker
LEGACY_DB_USER=sa
LEGACY_DB_PASSWORD=yourpassword
LEGACY_DB_ENCRYPT=true
LEGACY_DB_TRUST_SERVER_CERT=true
