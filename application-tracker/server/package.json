  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.1",
